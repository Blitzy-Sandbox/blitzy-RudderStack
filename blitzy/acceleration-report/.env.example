# .env.example — Environment variable template for blitzy/acceleration-report/
# Copy to .env and fill in real values to enable higher API rate limits and Linear access.
# All variables are OPTIONAL — the pipeline falls back to local-git data when API access is unavailable.
# Real secrets MUST NOT be committed to source control. .env is gitignored.

# ---- Required ----

# GitHub repository slug for API calls.
# Format: <org>/<repo>
GITHUB_REPO_SLUG=Blitzy-Sandbox/blitzy-RudderStack

# ---- Optional (HTTP API access) ----

# GitHub Personal Access Token with scopes: repo:read, actions:read
# When absent, pipeline runs in offline mode using only local-git data; confidence tiers may drop accordingly.
# Token MUST have read-only scopes. Pipeline performs NO writes.
GH_TOKEN=

# Linear API key (https://linear.app/settings/api)
# When absent, Metric 12 (Defects Out of SLA) reports "Insufficient signal — no SLA source"
# and Metric 6 (Flow Distribution) falls back to conventional-commit-prefix classification only.
LINEAR_API_KEY=

# ---- Optional (Analysis Window) ----

# Override the analysis start date. Default: earliest commit timestamp in local clone.
# Format: ISO-8601 UTC, e.g., 2026-02-23T00:00:00Z
ANALYSIS_START_DATE=

# Override the analysis end date. Default: extraction timestamp (now).
# Format: ISO-8601 UTC, e.g., 2026-05-21T23:59:59Z
ANALYSIS_END_DATE=

# ---- Optional (Run Correlation) ----

# Override the per-run correlation ID used by the structured-JSON logger.
# Default: auto-generated UUID4 by 00_environment.sh
# Useful for replaying or comparing two runs side-by-side.
BLITZY_RUN_ID=

# ---- Optional (Debugging) ----

# Log level for structured-JSON logger. Default: INFO. Other values: DEBUG, WARNING, ERROR.
LOG_LEVEL=INFO

# When set to 1, scripts print a JSON description of every external endpoint and git command
# they would invoke, then exit without making any external calls. Useful for readiness preflight.
DRY_RUN=
