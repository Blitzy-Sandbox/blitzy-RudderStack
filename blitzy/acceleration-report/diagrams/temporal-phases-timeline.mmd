%% Title: Temporal Phase Decomposition: Baseline → Post-Introduction
%% Legend:
%%   Each bar represents a phase of the measurement window.
%%   Baseline          = period from earliest commit (2026-02-23) to the AI inflection
%%                       point (2026-02-25), used for "before" metric extraction.
%%   Post-Introduction = period from the AI inflection point to the latest observed
%%                       commit on main, used for "after" metric extraction.
%%   Fallback applied: post-introduction span is <90 days, so per AAP §0.5.6
%%   the Ramp-Up (first 90 days) vs Steady-State (90+ days) split is NOT shown.
%%   The exact span (in days) for any given run is recorded in
%%   data/metrics.json#_metadata.post_introduction_duration_days; this diagram
%%   approximates it with a fixed bar length for visual stability across reruns.
%%   This decision is logged as DL-006 in decision-log.md.
%%   The AI inflection point was resolved via Tier 2 (AI-actor email pattern) detection;
%%   the first agent@blitzy.com commit landed at 2026-02-25 02:58:59 UTC
%%   (commit 803732e140796ac4db4343c22791025b6503885c).
gantt
    title Temporal Phase Decomposition: Baseline -> Post-Introduction
    dateFormat  YYYY-MM-DD
    axisFormat  %Y-%m-%d
    section Baseline
    Pre-inflection observation    :baseline, 2026-02-23, 2d
    section Post-Introduction (fallback applied: <90 days post-inflection)
    AI assistance active          :post, 2026-02-25, 88d
