%% Title: Data Source Topology
%% Legend:
%%   Solid arrows (-->)   = primary data flow into extraction scripts
%%   Dotted arrows (-.->) = optional / fallback paths (Linear without LINEAR_API_KEY,
%%                          admin audit log without admin access, JUnit XML when absent)
%%   Plain rectangles     = read-only data sources (external APIs or local files)
%%   Rounded rectangles   = extraction scripts under blitzy/acceleration-report/scripts/
%%   Cylinders ([(...)])  = raw data artifacts under blitzy/acceleration-report/data/
%%   Subgraphs            = data-source modality (External APIs vs Local Filesystem)
%%                          and downstream stages (Extraction Scripts vs Raw Data Sinks)
%%   Mirrors AAP §0.2.1 Data Source Inventory.
%%   All data flow is READ-ONLY: scripts perform HTTP GET only; no POST/PUT/PATCH/DELETE.
flowchart LR
    subgraph EXT["External APIs (read-only HTTP GET)"]
        API1[GitHub Pulls API]
        API2[GitHub Reviews API]
        API3[GitHub Pull-Commits API]
        API4[GitHub Pull-Events API]
        API5[GitHub Releases API]
        API6[GitHub Actions Runs API]
        API7[GitHub Branches API]
        API8[Linear GraphQL API]
    end
    subgraph LOCAL["Local Filesystem (read-only)"]
        F1[".git/ history refs tags reflog"]
        F2[".github/workflows/ *.yml *.yaml"]
        F3[".golangci.yml .snyk .truffleignore .deepsource.toml"]
        F4["CHANGELOG.md releases.md"]
        F5["**/*_test.go 497 files"]
        F6["docs/ blitzy-docs/ blitzy/documentation/"]
        F7[".github/labeler.yml .github/dependabot.yml"]
        F8[".github/pull_request_template.md .github/ISSUE_TEMPLATE/"]
    end
    subgraph SCRIPTS["Extraction Scripts (blitzy/acceleration-report/scripts/)"]
