%% Title: Read-Only Extraction → Compute → Render Pipeline
%% Legend:
%%   Solid arrows (-->)             = data flow
%%   Rounded rectangles ([Script])  = extraction / compute / render scripts under scripts/
%%   Cylinders ([(artifact.ext)])   = JSON / CSV data artifacts under data/
%%   Ovals ([(name)])               = final rendered deliverables (Markdown report + HTML deck)
%%   Subgraphs                      = pipeline stages (Extract, Data, Compute, Render)
%%   Mirrors the architecture diagram in AAP §0.5.1 verbatim.
%%   The pipeline is strictly read-only against the analyzed rudder-server repository:
%%     - scripts 00-08 read from .git/, .github/, and the GitHub/Linear APIs
%%     - script 09 reads from data/*.json|csv and writes data/metrics.json + data/per_engineer.json
%%     - scripts 10-11 read from data/metrics.json + data/per_engineer.json only
%%   No script writes to the analyzed repository, external systems, or any path outside blitzy/acceleration-report/.
flowchart LR
    subgraph EXTRACT["Extract (scripts 00-08)"]
        E1[00_environment.sh]
        E2[01_detect_inflection.py]
        E3[02_extract_commits.sh]
        E4[03_extract_pulls.py]
        E5[04_extract_releases.py]
        E6[05_extract_reverts.sh]
        E7[06_extract_ci_history.py]
        E8[07_extract_exceptions.py]
        E9[08_extract_linear.py]
    end
    subgraph DATA["data/ (raw artifacts)"]
        D1[(environment.json)]
        D2[(inflection.json)]
        D3[(commits.csv)]
        D4[(pulls.json)]
        D5[(releases.json)]
        D6[(reverts.json)]
        D7[(ci_runs.json)]
        D8[(exceptions.json)]
        D9[(issues.json)]
    end
    subgraph COMPUTE["Compute (script 09)"]
        C1[09_compute_metrics.py]
        M[(metrics.json)]
        P[(per_engineer.json)]
    end
    subgraph RENDER["Render (scripts 10-11)"]
        R1[10_render_report.py]
        R2[11_render_deck.py]
        REP([acceleration-report.md])
        DEC([executive-summary.html])
    end
    E1 --> D1
    E2 --> D2
    E3 --> D3
    E4 --> D4
    E5 --> D5
    E6 --> D6
    E7 --> D7
    E8 --> D8
    E9 --> D9
    D1 & D2 & D3 & D4 & D5 & D6 & D7 & D8 & D9 --> C1
    C1 --> M
    C1 --> P
    M --> R1
    P --> R1
    M --> R2
    P --> R2
    R1 --> REP
    R2 --> DEC
