    "client_id_derivation": {
      "description": "The GA4 client_id is a required field that uniquely identifies a browser instance or device. It is derived from the Segment/RudderStack event context and identity fields.",
      "derivation_priority": [
        {
          "priority": 1,
          "source": "context.integrations.Google Analytics 4.clientId",
          "notes": "Explicit client_id passed via integration-specific options"
        },
        {
          "priority": 2,
          "source": "properties.clientId or properties.client_id",
          "notes": "Client ID passed as an event property"
        },
        {
          "priority": 3,
          "source": "context.ga4.clientId",
          "notes": "Client ID from GA4-specific context namespace"
        },
        {
          "priority": 4,
          "source": "anonymousId",
          "notes": "Falls back to the anonymous ID assigned by the SDK. Segment uses format '<random>.<timestamp>', RudderStack uses UUID v4."
        },
        {
          "priority": 5,
          "source": "userId",
          "notes": "Last resort fallback. Not recommended as client_id should represent a device/browser, not a user."
        }
      ],
      "format": "String. Typically '<random_number>.<unix_timestamp>' for web (e.g., '1234567890.1678886400'). For mobile, use the Firebase app_instance_id.",
      "user_id_note": "The GA4 user_id field (separate from client_id) is set from the Segment/RudderStack userId when present. This enables cross-device identity stitching in GA4."
    },
    "session_handling": {
      "description": "GA4 requires session_id and engagement_time_msec parameters for events to appear in real-time and session-scoped reports. Without these parameters, events are processed but may show as '(not set)' in attribution reports.",
      "session_id": {
        "derivation": [
          {
            "priority": 1,
            "source": "properties.sessionId or properties.session_id",
            "notes": "Explicit session ID from event properties"
          },
          {
            "priority": 2,
            "source": "context.sessionId",
            "notes": "Session ID from SDK context"
          },
          {
            "priority": 3,
            "source": "Timestamp-derived (epoch seconds of session start)",
            "notes": "Falls back to a timestamp-based session ID if not explicitly provided. GA4 sessions are identified by unique session_id values — sending a new session_id starts a new session."
          }
        ],
        "format": "String representation of a positive integer (epoch seconds recommended). Must not change within a session.",
        "new_session_behavior": "A new unique session_id value causes GA4 to count a new session."
      },
      "engagement_time_msec": {
        "description": "Required for events to display in real-time reports. Represents the engagement time in milliseconds. Minimum recommended value is 1.",
        "default_value": 100,
        "derivation": "Set from context.engagement_time_msec if available, otherwise defaults to 100ms."
      }
    },
    "page_and_screen_mapping": {
      "page_event": {
        "description": "Segment/RudderStack page calls map to GA4 page_view events. Page properties are mapped to GA4 page_view recommended parameters.",
        "field_map": {
          "name": "page_title (also used as event parameter if needed)",
          "properties.title": "page_title",
          "properties.url": "page_location",
          "properties.path": "page_location (fallback, combined with origin if needed)",
          "properties.referrer": "page_referrer",
          "context.locale": "language",
          "context.screen.width + context.screen.height": "screen_resolution (formatted as 'WIDTHxHEIGHT')"
        }
      },
      "screen_event": {
        "description": "Segment/RudderStack screen calls map to GA4 screen_view events. Screen properties are mapped to Firebase screen parameters.",
        "field_map": {
          "name": "firebase_screen",
          "properties.screenClass or context.screen.class": "firebase_screen_class",
          "properties.screenId": "firebase_screen_id"
        },
        "notes": "screen_view is only allowed for App streams. For web streams, use page_view instead."
      }
    },
    "group_event_mapping": {
      "description": "Segment/RudderStack group calls do not have a direct GA4 equivalent. The recommended approach is to map group calls to the GA4 join_group event and store group traits as user properties.",
