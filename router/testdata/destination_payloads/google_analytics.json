    },
    "api_constraints": {
      "description": "GA4 Measurement Protocol enforces several payload constraints that must be respected during event transformation.",
      "max_events_per_request": 25,
      "max_params_per_event": 25,
      "max_user_properties_per_request": 25,
      "max_event_name_length": 40,
      "max_param_name_length": 40,
