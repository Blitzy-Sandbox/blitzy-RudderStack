  "field_mappings": {
    "event_name_mapping": {
      "description": "Mapping of Segment/RudderStack semantic event names to GA4 Measurement Protocol event names. Standard track events use the event name as-is (snake_cased). Ecommerce events are mapped to GA4 recommended ecommerce event names.",
      "rules": [
        {
          "source_event": "Order Completed",
          "ga4_event_name": "purchase",
          "notes": "GA4 recommended ecommerce event. Requires transaction_id, value, currency, items."
        },
        {
          "source_event": "Product Viewed",
          "ga4_event_name": "view_item",
          "notes": "GA4 recommended ecommerce event. Requires currency, value, items."
        },
        {
          "source_event": "Product Added",
          "ga4_event_name": "add_to_cart",
          "notes": "GA4 recommended ecommerce event. Requires currency, value, items."
        },
        {
          "source_event": "Product Removed",
          "ga4_event_name": "remove_from_cart",
          "notes": "GA4 recommended ecommerce event. Requires currency, value, items."
        },
        {
          "source_event": "Checkout Started",
          "ga4_event_name": "begin_checkout",
          "notes": "GA4 recommended ecommerce event. Requires currency, value, items."
        },
        {
          "source_event": "Product List Viewed",
          "ga4_event_name": "view_item_list",
          "notes": "GA4 recommended ecommerce event. Requires items with item_list_id, item_list_name."
        },
        {
          "source_event": "Product Clicked",
          "ga4_event_name": "select_item",
          "notes": "GA4 recommended ecommerce event. Requires items."
        },
        {
          "source_event": "Payment Info Entered",
          "ga4_event_name": "add_payment_info",
          "notes": "GA4 recommended ecommerce event. Requires currency, value, items. Optional: coupon, payment_type."
        },
        {
          "source_event": "Shipping Info Entered",
          "ga4_event_name": "add_shipping_info",
          "notes": "GA4 recommended ecommerce event. Requires currency, value, items. Optional: coupon, shipping_tier."
        },
        {
          "source_event": "Order Refunded",
          "ga4_event_name": "refund",
          "notes": "GA4 recommended ecommerce event. Requires transaction_id. For partial refunds include items."
        },
        {
          "source_event": "Promotion Viewed",
          "ga4_event_name": "view_promotion",
          "notes": "GA4 recommended ecommerce event. Requires items. Optional: promotion_id, promotion_name, creative_name, creative_slot."
        },
        {
          "source_event": "Promotion Clicked",
          "ga4_event_name": "select_promotion",
          "notes": "GA4 recommended ecommerce event. Requires items. Optional: promotion_id, promotion_name."
        },
        {
          "source_event": "Product Added to Wishlist",
          "ga4_event_name": "add_to_wishlist",
          "notes": "GA4 recommended ecommerce event. Requires currency, value, items."
        },
        {
          "source_event": "Cart Viewed",
          "ga4_event_name": "view_cart",
          "notes": "GA4 recommended ecommerce event. Requires currency, value, items."
        },
        {
          "source_event": "Products Searched",
          "ga4_event_name": "search",
          "notes": "GA4 recommended event. Requires search_term parameter."
        },
        {
          "source_event": "(any custom track)",
          "ga4_event_name": "snake_cased_event_name",
          "notes": "Custom track events are sent as-is with the event name converted to snake_case. Must not exceed 40 characters. Must start with an alphabetic character."
        }
      ]
    },
    "ecommerce_event_translation": {
      "description": "Mapping of Segment/RudderStack ecommerce product properties to GA4 items array fields. The items array can contain up to 200 elements with up to 27 custom parameters per item.",
      "product_to_item_fields": {
        "product_id": "item_id",
        "sku": "item_id (fallback if product_id absent)",
        "name": "item_name",
        "brand": "item_brand",
        "category": "item_category",
        "variant": "item_variant",
        "price": "price",
        "quantity": "quantity",
        "coupon": "coupon",
        "position": "index",
        "url": "(not mapped — GA4 items do not support url)",
        "image_url": "(not mapped — GA4 items do not support image_url)"
      },
      "order_to_event_fields": {
        "order_id": "transaction_id",
        "total": "value",
        "revenue": "value (fallback if total absent)",
        "currency": "currency",
        "tax": "tax",
        "shipping": "shipping",
        "coupon": "coupon",
        "discount": "discount",
        "affiliation": "affiliation"
      },
      "category_hierarchy": {
        "description": "GA4 supports up to 5 item category levels. A single Segment category string with delimiters is split into item_category through item_category5.",
        "example": {
          "source": "Apparel/Adult/Shirts/Crew/Short sleeve",
          "result": {
            "item_category": "Apparel",
            "item_category2": "Adult",
