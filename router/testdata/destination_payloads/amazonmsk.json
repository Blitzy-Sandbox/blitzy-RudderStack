  "field_mappings": {
    "note": "No direct Segment equivalent for Amazon MSK. Segment covers MSK through the generic Kafka destination (slug: actions-kafka). RudderStack implements Amazon MSK as a dedicated destination type (AMAZON_MSK) with MSK-specific authentication support.",
    "producer_routing": "AMAZON_MSK destination name routes through streammanager.NewProducer switch to the amazonmsk.NewProducer constructor",
    "shared_kafka_protocol": "Amazon MSK exposes the standard Apache Kafka wire protocol; the producer uses kafka-go for message production, similar to the standard Kafka and Confluent Cloud producers",
    "authentication_difference": "Standard Kafka supports flexible TLS/SASL configuration; Amazon MSK supports SASL/SCRAM-SHA-512 with AWS Secrets Manager-stored credentials or AWS IAM authentication via the aws-msk-iam-auth mechanism",
    "config_difference": "Amazon MSK uses bootstrapServer, authMechanism (scram/iam), and either SCRAM credentials or IAM role ARN — distinct from standard Kafka's generic SASL/TLS fields",
    "topic_resolution": "Per-event topic field in JSON payload takes precedence over the default topic from destination config",
    "partition_key": "Derived from the userId field in the event JSON; serves as the Kafka message key for partition assignment",
    "message_value": "The message field from the input JSON is extracted and re-serialized as the Kafka message value via jsonrs.Marshal",
    "timestamp_handling": "Kafka message timestamp is set to server time at produce invocation (time.Now()), not the event's original timestamp",
    "envelope_fields": "RudderStack events include rudderId, originalTimestamp, sentAt, receivedAt — these are part of the message value passed through to MSK",
    "encryption": "All MSK connections use TLS encryption in transit; MSK clusters can additionally enable at-rest encryption via AWS KMS"
  },
  "producer_details": {
    "constructor": "NewProducer",
    "package": "services/streammanager/amazonmsk",
    "config_struct": "mskConfig",
    "config_fields": {
      "Topic": "Name of the Kafka topic on the MSK cluster",
      "BootstrapServer": "Comma-separated MSK cluster bootstrap broker addresses",
      "AuthMechanism": "Authentication mechanism: 'scram' for SASL/SCRAM-SHA-512, 'iam' for AWS IAM",
      "SASLUsername": "SCRAM-SHA-512 username (when AuthMechanism is 'scram')",
      "SASLPassword": "SCRAM-SHA-512 password (when AuthMechanism is 'scram')",
      "IAMRoleArn": "AWS IAM role ARN (when AuthMechanism is 'iam')",
      "Region": "AWS region (when AuthMechanism is 'iam')"
    },
    "default_publish_timeout_seconds": 10,
    "metrics": {
      "creation_time": "router.amazonmsk.creation_time",
      "produce_time": "router.amazonmsk.produce_time",
      "publish_time": "router.amazonmsk.publish_time",
      "close_time": "router.amazonmsk.close_producer_time",
      "missing_user_id": "router.amazonmsk.missing_user_id",
      "missing_message": "router.amazonmsk.missing_message"
    },
    "avro_support": false,
    "ssh_support": false
  },
  "parity_status": "not_applicable",
  "parity_coverage_percent": null,
  "notes": "Amazon MSK (Managed Streaming for Apache Kafka) is a RudderStack-unique stream destination. There is no direct Segment Amazon MSK destination; Segment covers MSK clusters via the generic Kafka destination (slug: actions-kafka). RudderStack implements Amazon MSK as a dedicated destination type (AMAZON_MSK) with specialized support for AWS-native authentication mechanisms including SASL/SCRAM-SHA-512 (credentials stored in AWS Secrets Manager) and AWS IAM authentication. The producer leverages the standard Apache Kafka wire protocol exposed by MSK clusters, authenticated over TLS. The destination is registered in the stream manager factory (services/streammanager/streammanager.go) and listed in the Custom Destination Manager's ObjectStreamDestinations array (router/customdestinationmanager/customdestinationmanager.go). Configuration requires: topic, bootstrapServer, authMechanism, and either SCRAM credentials or IAM role ARN with region. Since there is no direct Segment equivalent, payload parity comparison is not applicable — this fixture documents RudderStack's Amazon MSK payload format for regression testing and field-by-field validation."
}
