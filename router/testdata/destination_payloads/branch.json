{
  "destination_type": "BRANCH",
  "destination_tier": "cloud",
  "segment_slug": "branch-metrics",
  "categories": ["Attribution", "Deep Linking"],
  "api_endpoint": "https://api2.branch.io/v2/event/standard",
  "custom_event_endpoint": "https://api2.branch.io/v2/event/custom",
  "event_types": ["track", "identify"],
  "segment_reference_payload": {
    "track": {
      "description": "Segment track event mapped to Branch v2 Event API. Standard commerce events (Order Completed, Product Added, etc.) are mapped to Branch standard events (PURCHASE, ADD_TO_CART, etc.) via POST /v2/event/standard. Non-standard events are sent as custom events via POST /v2/event/custom.",
      "endpoint": "POST /v2/event/standard",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "name": "PURCHASE",
        "customer_event_alias": "Order Completed",
        "user_data": {
          "os": "Android",
          "os_version": "13",
          "environment": "FULL_APP",
          "aaid": "97987bca-ae59-4c7d-94ba-ee4f19ab8c21",
          "android_id": "a12300000000",
          "limit_ad_tracking": false,
          "developer_identity": "user_123",
          "country": "US",
          "language": "en",
          "ip": "192.168.1.1",
          "user_agent": "Mozilla/5.0 (Linux; Android 13; Pixel 7)",
          "brand": "Google",
          "app_version": "3.2.1",
          "model": "Pixel 7",
          "screen_dpi": 420,
          "screen_height": 2400,
          "screen_width": 1080
        },
        "event_data": {
          "transaction_id": "txn-abc-123",
          "currency": "USD",
          "revenue": 180.20,
          "shipping": 10.50,
          "tax": 13.50,
          "coupon": "SAVE20",
          "affiliation": "web_store",
          "description": "Order completed by user"
        },
        "custom_data": {
          "order_id": "ord-456",
          "payment_method": "credit_card"
        },
        "content_items": [
          {
            "$content_schema": "COMMERCE_PRODUCT",
            "$og_title": "Premium Widget",
            "$canonical_identifier": "SKU-001",
            "$price": 49.99,
            "$quantity": 2,
            "$sku": "SKU-001",
            "$product_name": "Premium Widget",
            "$product_brand": "WidgetCo",
            "$product_category": "Electronics",
            "$product_variant": "Blue"
          }
        ],
        "metadata": {},
        "branch_key": "key_live_XXXXXXXXXXXX"
      }
    },
    "track_custom": {
      "description": "Segment track events that do not map to a Branch standard event are sent as custom events via POST /v2/event/custom.",
      "endpoint": "POST /v2/event/custom",
      "body": {
        "name": "Video Played",
        "user_data": {
          "os": "iOS",
          "os_version": "17.2",
          "environment": "FULL_APP",
          "idfa": "6D92078A-8246-4BA4-AE5B-76104861E7DC",
          "idfv": "A1B2C3D4-E5F6-7890-ABCD-EF1234567890",
          "limit_ad_tracking": false,
          "developer_identity": "user_123",
          "country": "US",
          "language": "en",
          "ip": "192.168.1.1",
          "brand": "Apple",
          "app_version": "3.2.1",
          "model": "iPhone 15"
        },
        "custom_data": {
          "video_id": "vid-789",
          "video_title": "Product Demo",
          "duration": 120,
          "category": "tutorial"
        },
        "metadata": {},
        "branch_key": "key_live_XXXXXXXXXXXX"
      }
    },
    "identify": {
      "description": "Segment identify events map userId to Branch developer_identity. Traits are sent as user profile data. The identify call itself does not map to a standalone Branch API call; instead, the developer_identity from identify is used to enrich subsequent track events.",
      "mapping_behavior": "userId is stored and attached to subsequent Branch events as user_data.developer_identity. Traits such as email, name, and phone are not natively consumed by Branch standard events but may be passed in custom_data.",
      "body": null
    }
  },
