  "field_mappings": {
    "event_name_mapping": {
      "description": "Both Segment and RudderStack map Segment Spec event names to Branch standard event names. Non-matching events are routed to the custom event endpoint.",
      "standard_event_map": {
        "Order Completed": "PURCHASE",
        "Product Added": "ADD_TO_CART",
        "Product Added to Wishlist": "ADD_TO_WISHLIST",
        "Product Viewed": "VIEW_ITEM",
        "Products Searched": "SEARCH",
        "Checkout Started": "INITIATE_PURCHASE",
        "Payment Info Entered": "ADD_PAYMENT_INFO",
        "Promotion Viewed": "VIEW_AD",
        "Promotion Clicked": "CLICK_AD",
        "Product List Viewed": "VIEW_ITEMS",
        "Product Shared": "SHARE",
        "Cart Shared": "SHARE",
        "Signed Up": "COMPLETE_REGISTRATION",
        "Application Installed": "INSTALL",
        "Application Opened": "OPEN"
      },
      "parity_status": "needs_verification",
      "known_gaps": "Event name mapping may differ slightly between Segment and RudderStack Transformer configurations. Custom event names are passed through as-is to the /v2/event/custom endpoint."
    },
    "user_identification": {
      "description": "Device identification is critical for Branch attribution. Both platforms must extract device identifiers from the event context.",
      "mappings": {
        "userId": {
          "branch_field": "user_data.developer_identity",
          "segment_source": "userId",
          "rudderstack_source": "userId",
          "parity": "equivalent"
        },
        "advertising_id_android": {
          "branch_field": "user_data.aaid",
          "segment_source": "context.device.advertisingId (when context.os.name=Android)",
          "rudderstack_source": "context.device.advertisingId (when context.os.name=Android)",
          "parity": "equivalent"
        },
        "advertising_id_ios": {
          "branch_field": "user_data.idfa",
          "segment_source": "context.device.advertisingId (when context.os.name=iOS)",
          "rudderstack_source": "context.device.advertisingId (when context.os.name=iOS)",
          "parity": "equivalent"
        },
        "idfv": {
          "branch_field": "user_data.idfv",
          "segment_source": "context.device.id (iOS fallback)",
          "rudderstack_source": "context.device.id (iOS fallback)",
          "parity": "needs_verification"
        },
        "android_id": {
          "branch_field": "user_data.android_id",
          "segment_source": "context.device.id (Android fallback)",
          "rudderstack_source": "context.device.id (Android fallback)",
          "parity": "needs_verification"
        },
        "anonymous_id": {
          "branch_field": "not_mapped",
          "segment_source": "anonymousId",
          "rudderstack_source": "anonymousId",
          "notes": "Branch does not natively map anonymous ID. It may be passed in custom_data but is not used for attribution.",
          "parity": "equivalent"
        },
        "browser_fingerprint_id": {
          "branch_field": "user_data.browser_fingerprint_id",
          "segment_source": "properties.browser_fingerprint_id or integrations.Branch.browser_fingerprint_id",
          "rudderstack_source": "properties.browser_fingerprint_id or integrations.Branch.browser_fingerprint_id",
          "notes": "Required for web event attribution. Must be collected via Branch Web SDK and passed explicitly.",
          "parity": "needs_verification"
        }
      },
      "required_identifiers": "Branch requires at least one of: developer_identity, browser_fingerprint_id, iOS IDFA/IDFV, or Android GAID/android_id"
    },
    "device_context": {
      "description": "Device metadata extracted from the event context object and mapped to Branch user_data fields.",
      "mappings": {
        "os": {
          "branch_field": "user_data.os",
          "segment_source": "context.os.name",
          "rudderstack_source": "context.os.name",
          "parity": "equivalent"
        },
        "os_version": {
          "branch_field": "user_data.os_version",
          "segment_source": "context.os.version",
          "rudderstack_source": "context.os.version",
          "parity": "equivalent"
        },
        "model": {
          "branch_field": "user_data.model",
          "segment_source": "context.device.model",
          "rudderstack_source": "context.device.model",
          "parity": "equivalent"
        },
        "brand": {
          "branch_field": "user_data.brand",
          "segment_source": "context.device.manufacturer",
          "rudderstack_source": "context.device.manufacturer",
          "parity": "needs_verification"
        },
        "screen_dpi": {
          "branch_field": "user_data.screen_dpi",
          "segment_source": "context.screen.density",
          "rudderstack_source": "context.screen.density",
          "parity": "needs_verification"
        },
        "screen_height": {
          "branch_field": "user_data.screen_height",
          "segment_source": "context.screen.height",
          "rudderstack_source": "context.screen.height",
          "parity": "equivalent"
        },
        "screen_width": {
          "branch_field": "user_data.screen_width",
          "segment_source": "context.screen.width",
          "rudderstack_source": "context.screen.width",
          "parity": "equivalent"
        },
        "ip": {
          "branch_field": "user_data.ip or X-IP-Override header",
          "segment_source": "context.ip",
          "rudderstack_source": "context.ip or request_ip",
          "notes": "Server-to-server calls must set IP via X-IP-Override header for accurate geo attribution.",
          "parity": "needs_verification"
        },
        "user_agent": {
          "branch_field": "user_data.user_agent",
          "segment_source": "context.userAgent",
          "rudderstack_source": "context.userAgent",
          "parity": "equivalent"
        },
        "country": {
          "branch_field": "user_data.country",
          "segment_source": "context.locale (derived)",
          "rudderstack_source": "context.locale (derived)",
          "parity": "needs_verification"
        },
        "language": {
          "branch_field": "user_data.language",
          "segment_source": "context.locale (derived)",
          "rudderstack_source": "context.locale (derived)",
          "parity": "needs_verification"
        },
        "app_version": {
          "branch_field": "user_data.app_version",
          "segment_source": "context.app.version",
          "rudderstack_source": "context.app.version",
          "parity": "equivalent"
        },
        "limit_ad_tracking": {
          "branch_field": "user_data.limit_ad_tracking",
          "segment_source": "context.device.adTrackingEnabled (inverted)",
          "rudderstack_source": "context.device.adTrackingEnabled (inverted)",
          "notes": "Branch uses limit_ad_tracking=true to opt out; Segment uses adTrackingEnabled=false. The boolean is inverted.",
          "parity": "needs_verification"
        },
        "environment": {
          "branch_field": "user_data.environment",
          "segment_source": "derived from context (FULL_APP for mobile, WEB_BROWSER for web)",
          "rudderstack_source": "derived from context (FULL_APP for mobile, WEB_BROWSER for web)",
          "parity": "needs_verification"
        }
      }
    },
