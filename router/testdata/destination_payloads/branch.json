    "content_items": {
      "description": "Product/content data from Segment Spec products array mapped to Branch content_items array.",
      "mappings": {
        "product_id": {
          "branch_field": "$canonical_identifier",
          "segment_source": "properties.products[].product_id",
          "rudderstack_source": "properties.products[].product_id",
