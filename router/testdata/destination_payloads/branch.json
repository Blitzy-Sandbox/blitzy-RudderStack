          "parity": "equivalent"
        }
      }
    },
    "deep_link_data": {
      "description": "Branch-specific deep link metadata that may be passed via Segment/RudderStack integrations object.",
      "mappings": {
        "branch_key": {
          "branch_field": "branch_key",
          "segment_source": "destination config (Branch Key setting)",
          "rudderstack_source": "destination config (Branch Key setting)",
          "parity": "equivalent"
        },
        "customer_event_alias": {
          "branch_field": "customer_event_alias",
          "segment_source": "derived from original event name when mapped to standard event",
          "rudderstack_source": "derived from original event name when mapped to standard event",
          "parity": "needs_verification"
        }
      }
    },
    "dma_compliance": {
      "description": "EU Digital Markets Act compliance fields for consent management.",
      "mappings": {
        "dma_eea": {
          "branch_field": "user_data.dma_eea",
          "segment_source": "context.consent.dma_eea or integrations.Branch.dma_eea",
          "rudderstack_source": "context.consent.dma_eea or integrations.Branch.dma_eea",
          "parity": "needs_verification"
        },
        "dma_ad_personalization": {
          "branch_field": "user_data.dma_ad_personalization",
          "segment_source": "context.consent.dma_ad_personalization or integrations.Branch.dma_ad_personalization",
          "rudderstack_source": "context.consent.dma_ad_personalization or integrations.Branch.dma_ad_personalization",
          "parity": "needs_verification"
        },
        "dma_ad_user_data": {
          "branch_field": "user_data.dma_ad_user_data",
          "segment_source": "context.consent.dma_ad_user_data or integrations.Branch.dma_ad_user_data",
          "rudderstack_source": "context.consent.dma_ad_user_data or integrations.Branch.dma_ad_user_data",
          "parity": "needs_verification"
        }
      }
    },
    "envelope_differences": {
      "description": "Additional RudderStack envelope fields not present in Segment payloads. These are stripped during transformation and do not appear in the Branch API request.",
      "rudderstack_only_fields": [
        "rudderId",
        "originalTimestamp",
        "sentAt",
        "receivedAt"
      ],
      "notes": "RudderStack envelope fields are internal to the RudderStack pipeline and are removed by the Transformer before sending to Branch. The final Branch API payload should be identical between Segment and RudderStack."
    }
  },
  "parity_assessment": {
    "overall_status": "needs_verification",
    "estimated_parity": "high",
    "rationale": "Branch destination payloads are generated by the external Transformer service which performs the Segment Spec to Branch API mapping. Both Segment and RudderStack use the same Branch v2 Event API endpoints. The transformation logic should produce equivalent payloads given identical input events.",
    "verification_required": [
      "Standard event name mapping completeness",
      "Device identifier extraction from context (IDFA vs GAID fallback logic)",
      "limit_ad_tracking boolean inversion from adTrackingEnabled",
      "brand field mapping (context.device.manufacturer vs context.device.brand)",
      "Screen DPI mapping from context.screen.density",
      "Country and language derivation from context.locale",
      "Browser fingerprint passthrough for web events",
      "DMA compliance field forwarding",
      "IP address handling (body field vs X-IP-Override header)",
      "customer_event_alias derivation when standard event mapping is applied",
      "Environment field derivation (FULL_APP vs WEB_BROWSER)"
    ]
  },
  "notes": "Branch is a shared cloud destination present in both RudderStack and Segment catalogs. Categories: Attribution, Deep Linking. Branch uses the v2 Event API (api2.branch.io) with separate endpoints for standard events (POST /v2/event/standard) and custom events (POST /v2/event/custom). Device identification is critical for attribution — at least one of developer_identity, browser_fingerprint_id, iOS IDFA/IDFV, or Android GAID/android_id must be present. RudderStack maps userId to developer_identity and extracts device identifiers from context.device. Anonymous ID is not natively used by Branch for attribution. The Transformer service handles the event-to-Branch payload mapping. Segment equivalent slug: branch-metrics. Key parity verification areas: event name mapping, device identifier extraction, DMA consent fields, and IP address handling for server-to-server calls."
}
