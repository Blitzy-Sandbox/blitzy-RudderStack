    "partition_strategy": {
      "default": "Ingestion-time partitioning (DAY granularity) using _PARTITIONTIME pseudo-column",
      "custom": "Configurable column-based partitioning (e.g., received_at with HOUR/DAY/MONTH/YEAR granularity) when Warehouse.bigquery.customPartitionsEnabled is true",
