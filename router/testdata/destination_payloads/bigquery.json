  "field_mappings": {
    "table_schema_naming": {
      "description": "Both platforms use lowercase snake_case table and column names for BigQuery. RudderStack's ToProviderCase for BQ returns names unchanged (lowercase). Segment uses dot-separated nested flattening.",
      "segment_dataset": "<source_slug>",
