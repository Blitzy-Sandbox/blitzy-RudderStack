  "rudderstack_expected_payload": {
    "description": "RudderStack BigQuery warehouse destination uses GCS staging followed by BigQuery Load Jobs. It creates dedup views (<table>_view) for each table using ROW_NUMBER() windowing. Loading is managed by the warehouse service with a 7-state upload state machine. Column names use lowercase snake_case. BQSTREAM (separate stream connector) provides direct Streaming Inserts as an alternative path.",
    "loading_method": {
      "primary": "GCS staging → BigQuery Load Job (loadTableByAppend)",
      "alternative": "BQSTREAM stream connector for real-time Streaming Inserts (separate destination type)"
    },
    "dataset_naming": "<namespace> (derived from source name, lowercased, sanitized)",
    "table_naming_convention": "snake_case, per event type (tracks, identifies, pages, screens, groups, aliases, users, rudder_discards, rudder_identity_merge_rules, rudder_identity_mappings)",
    "column_naming_convention": "lowercase snake_case with underscore-separated nested flattening (e.g., context.library.name → context_library_name). ToProviderCase for BQ returns string as-is (no case conversion).",
    "dedup_strategy": "Creates <table>_view dedup views using: SELECT * EXCEPT(__row_number) FROM (SELECT *, ROW_NUMBER() OVER (PARTITION BY <partition_key> ORDER BY loaded_at DESC) AS __row_number FROM <table> WHERE <partition_filter> BETWEEN <60_day_window>) WHERE __row_number = 1",
    "dedup_partition_keys": {
      "users": "id",
      "identifies": "id",
      "tracks": "id",
      "pages": "id",
      "screens": "id",
      "groups": "id",
      "aliases": "id",
      "rudder_discards": "row_id, column_name, table_name",
      "rudder_identity_merge_rules": "merge_property_1_type, merge_property_1_value, merge_property_2_type, merge_property_2_value",
      "rudder_identity_mappings": "merge_property_type, merge_property_value"
    },
    "data_type_mappings": {
      "boolean": "BOOLEAN",
      "int": "INTEGER",
      "float": "FLOAT",
      "string": "STRING",
      "datetime": "TIMESTAMP"
    },
