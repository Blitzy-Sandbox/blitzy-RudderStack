  "field_mappings": {
    "note": "No Segment equivalent. Uses Kafka-compatible producer via services/streammanager/kafka/.",
    "topic": "Derived from azureEventHubConfig.Topic in destination config; maps to the Event Hub name within the Event Hubs Namespace",
    "key": "Derived from userId field in the event via gjson (parsedJSON.Get('userId').String()); used as Kafka partition key",
    "value": "Full JSON-serialized event message extracted via parsedJSON.Get('message').Value() and re-marshaled with jsonrs",
    "bootstrap_server": "The Event Hubs Namespace endpoint in host:port format (typically port 9093); supports comma-separated list for multiple addresses",
    "connection_string": "Azure Event Hubs connection string starting with Endpoint=sb:// containing SharedAccessKey for SASL/PLAIN authentication over TLS",
    "envelope_fields": "RudderStack adds rudderId, originalTimestamp, sentAt, receivedAt to every event payload",
    "authentication": "Azure Event Hub uses SASL/PLAIN over TLS via the Kafka protocol; credentials derived from EventHubsConnectionString using client.NewAzureEventHubs"
  },
  "producer_details": {
    "constructor": "NewProducerForAzureEventHubs",
    "package": "services/streammanager/kafka",
    "config_struct": "azureEventHubConfig",
    "config_fields": {
      "Topic": "Name of the Event Hub (not the namespace)",
      "BootstrapServer": "host:port format (port usually 9093 on Azure Event Hubs)",
      "EventHubsConnectionString": "Starts with Endpoint=sb:// and contains SharedAccessKey"
    },
    "client_factory": "client.NewAzureEventHubs",
    "producer_config_provider": "AZURE_EVENT_HUB",
    "default_publish_timeout_seconds": 10,
    "metrics": {
      "creation_time": "router.kafka.creation_time_azure_event_hubs",
      "produce_time": "router.kafka.produce_time",
      "publish_time": "router.kafka.publish_time",
      "close_time": "router.kafka.close_producer_time"
    },
    "avro_support": false,
    "ssh_support": false
  },
  "notes": "Azure Event Hub is RudderStack-unique. Uses shared Kafka producer (NewProducerForAzureEventHubs). Segment has no Azure Event Hub destination in its catalog. The producer leverages the Kafka wire protocol exposed by Azure Event Hubs on port 9093, authenticating via SASL/PLAIN with the Event Hubs connection string. Configuration requires the Event Hub name (topic), bootstrap server (namespace endpoint), and connection string. Unlike standard Kafka, Azure Event Hub does not support Avro serialization or SSH tunneling through this producer path. The dial timeout is configurable via Router.AZURE_EVENT_HUB.dialTimeout."
