  "field_mappings": {
    "user_identification": {
      "description": "Maps Segment/RudderStack user identity fields to PostHog distinct_id. PostHog uses a single distinct_id for all user identification. For anonymous users, the anonymousId is used; for known users, userId takes precedence.",
      "mappings": [
        {
          "source_field": "userId",
          "destination_field": "distinct_id",
          "transform": "direct",
          "notes": "Used as primary distinct_id when present; identifies a known user in PostHog"
        },
        {
          "source_field": "anonymousId",
          "destination_field": "distinct_id",
          "transform": "fallback_when_userId_absent",
          "notes": "Used as distinct_id only when userId is not provided (anonymous users)"
        },
        {
          "source_field": "anonymousId",
          "destination_field": "properties.$anon_distinct_id",
          "transform": "direct_on_identify",
          "notes": "Set on $identify events to enable identity merging between anonymous and identified users"
        }
      ]
    },
    "identify_trait_splitting": {
      "description": "Segment/RudderStack identify traits are split into PostHog $set (mutable) and $set_once (immutable) property groups. Properties that represent initial or creation-time values are routed to $set_once; all others go to $set.",
      "mappings": [
        {
          "source_field": "traits.*",
          "destination_field": "properties.$set.*",
          "transform": "default_all_traits",
          "notes": "All traits are placed in $set by default (overwritten on every identify call)"
        },
        {
          "source_field": "traits.createdAt",
          "destination_field": "properties.$set_once.createdAt",
          "transform": "move_to_set_once",
          "notes": "createdAt is moved from $set to $set_once since it should never change after initial set"
        },
        {
          "source_field": "traits.company.name",
          "destination_field": "properties.$set.company_name",
          "transform": "flatten_nested_object",
          "notes": "Nested company object is flattened: company.name → company_name, company.id → company_id"
        },
        {
          "source_field": "traits.company.id",
          "destination_field": "properties.$set.company_id",
          "transform": "flatten_nested_object",
          "notes": "Nested company object is flattened with underscore separator"
        }
      ]
    },
    "event_name_mapping": {
      "description": "Maps Segment/RudderStack event call types to PostHog event names. Track events preserve their custom event name; other call types are mapped to PostHog's standard special event names.",
      "mappings": [
        {
          "source_field": "event (track)",
          "destination_field": "event",
          "transform": "direct",
          "notes": "Custom track event name is used as-is in PostHog"
        },
        {
          "source_field": "type=identify",
          "destination_field": "event=$identify",
          "transform": "constant",
          "notes": "All identify calls become $identify events"
        },
        {
          "source_field": "type=page",
          "destination_field": "event=$pageview",
          "transform": "constant",
          "notes": "All page calls become $pageview events"
        },
        {
          "source_field": "type=screen",
          "destination_field": "event=$screen",
          "transform": "constant",
          "notes": "All screen calls become $screen events"
        },
        {
          "source_field": "type=group",
          "destination_field": "event=$groupidentify",
          "transform": "constant",
          "notes": "All group calls become $groupidentify events with $group_type, $group_key, $group_set"
        },
        {
          "source_field": "type=alias",
          "destination_field": "event=$create_alias",
          "transform": "constant",
          "notes": "All alias calls become $create_alias events with previousId as alias property"
        }
      ]
    },
    "page_properties": {
      "description": "Maps Segment/RudderStack page properties to PostHog standard $-prefixed page properties used for web analytics features like pageview tracking and session replay.",
      "mappings": [
        {
          "source_field": "properties.url",
          "destination_field": "properties.$current_url",
          "transform": "rename",
          "notes": "Page URL mapped to PostHog's standard $current_url property"
        },
        {
          "source_field": "properties.path",
          "destination_field": "properties.$pathname",
          "transform": "rename",
          "notes": "Page path mapped to PostHog's standard $pathname property"
        },
        {
          "source_field": "properties.url (hostname)",
          "destination_field": "properties.$host",
          "transform": "extract_hostname",
          "notes": "Hostname is extracted from the full URL and set as $host"
        },
        {
          "source_field": "properties.referrer",
          "destination_field": "properties.$referrer",
          "transform": "rename",
          "notes": "Referrer URL mapped to PostHog's standard $referrer property"
        },
        {
          "source_field": "properties.title",
          "destination_field": "properties.$title",
          "transform": "rename",
          "notes": "Page title mapped to PostHog's standard $title property"
        }
      ]
    },
    "group_properties": {
      "description": "Maps Segment/RudderStack group fields to PostHog $groupidentify event structure. PostHog groups require explicit $group_type (analytics entity type) and $group_key (unique identifier) with properties sent via $group_set.",
      "mappings": [
        {
          "source_field": "groupId",
          "destination_field": "properties.$group_key",
          "transform": "direct",
          "notes": "Group identifier becomes the PostHog $group_key"
        },
        {
          "source_field": "category (or default 'company')",
          "destination_field": "properties.$group_type",
          "transform": "default_to_company",
          "notes": "Group type defaults to 'company' if no category is provided; maps to PostHog group analytics entity type"
        },
        {
          "source_field": "traits.*",
          "destination_field": "properties.$group_set.*",
          "transform": "wrap_in_group_set",
          "notes": "All group traits are placed inside $group_set for PostHog group property assignment"
        },
        {
          "source_field": "traits.address.*",
          "destination_field": "properties.$group_set.address_*",
          "transform": "flatten_nested_with_prefix",
          "notes": "Nested address object is flattened with underscore separator inside $group_set"
        }
      ]
    },
    "context_fields": {
      "description": "Maps Segment/RudderStack context metadata to PostHog $-prefixed properties for browser, device, OS, and campaign attribution. These enrichments enable PostHog features like session replay, web analytics, and attribution reports.",
      "mappings": [
        {
          "source_field": "context.userAgent",
          "destination_field": "properties.$browser, properties.$os",
          "transform": "parse_user_agent",
          "notes": "User agent string is parsed into $browser and $os values"
        },
        {
          "source_field": "context.screen.width",
          "destination_field": "properties.$screen_width",
          "transform": "rename",
          "notes": "Screen dimensions mapped to PostHog viewport properties"
        },
        {
          "source_field": "context.screen.height",
          "destination_field": "properties.$screen_height",
          "transform": "rename",
          "notes": "Screen height mapped to PostHog viewport property"
        },
        {
          "source_field": "context.campaign.source",
          "destination_field": "properties.utm_source",
          "transform": "rename",
          "notes": "Campaign source mapped to standard utm_source parameter"
        },
        {
          "source_field": "context.campaign.medium",
          "destination_field": "properties.utm_medium",
          "transform": "rename",
          "notes": "Campaign medium mapped to standard utm_medium parameter"
        },
        {
          "source_field": "context.campaign.name",
          "destination_field": "properties.utm_campaign",
          "transform": "rename",
          "notes": "Campaign name mapped to standard utm_campaign parameter"
        },
        {
          "source_field": "context.library.name",
          "destination_field": "properties.$lib",
          "transform": "rename",
          "notes": "Library name set as $lib property; Segment uses analytics.js while RudderStack uses rudder-sdk-js"
        },
        {
          "source_field": "context.device.id",
          "destination_field": "properties.$device_id",
          "transform": "rename",
          "notes": "Mobile device ID mapped to PostHog $device_id property"
        },
        {
          "source_field": "context.device.manufacturer",
          "destination_field": "properties.$device_manufacturer",
          "transform": "rename",
          "notes": "Device manufacturer mapped to PostHog property"
        },
        {
          "source_field": "context.device.model",
          "destination_field": "properties.$device_model",
          "transform": "rename",
          "notes": "Device model mapped to PostHog property"
        },
        {
          "source_field": "context.os.name",
          "destination_field": "properties.$os",
          "transform": "rename",
          "notes": "Operating system name from context.os mapped to $os"
        },
        {
          "source_field": "context.os.version",
          "destination_field": "properties.$os_version",
          "transform": "rename",
          "notes": "OS version from context.os mapped to $os_version"
        },
        {
          "source_field": "context.app.name",
          "destination_field": "properties.$app_name",
          "transform": "rename",
          "notes": "Mobile app name mapped to PostHog $app_name property"
        },
        {
          "source_field": "context.app.version",
          "destination_field": "properties.$app_version",
          "transform": "rename",
          "notes": "Mobile app version mapped to PostHog $app_version property"
        },
        {
          "source_field": "context.app.build",
          "destination_field": "properties.$app_build",
          "transform": "rename",
          "notes": "Mobile app build number mapped to PostHog $app_build property"
        }
      ]
    }
  },
  "destination_config": {
    "required_settings": [
      {
        "key": "apiKey",
        "type": "string",
        "description": "PostHog project API key (phc_... format). Found in Project Settings > Project Variables. Used as the api_key field in all Capture API requests.",
        "example": "phc_1a2b3c4d5e6f7g8h9i0jklmnopqrstuv"
      },
      {
        "key": "hostUrl",
        "type": "string",
        "description": "PostHog instance URL for API requests. Use 'https://us.i.posthog.com' for US Cloud, 'https://eu.i.posthog.com' for EU Cloud, or your self-hosted instance URL.",
        "example": "https://us.i.posthog.com",
        "default": "https://us.i.posthog.com"
      }
    ],
    "optional_settings": [
      {
        "key": "groupTypeMapping",
        "type": "object",
        "description": "Mapping from Segment/RudderStack group categories to PostHog group types. If not set, all groups default to 'company' type. PostHog supports up to 5 group types per project.",
        "example": {
          "organization": "company",
          "team": "team",
          "project": "project"
        }
      },
      {
        "key": "useV2Endpoint",
        "type": "boolean",
        "description": "Whether to use PostHog's newer /i/v0/e/ endpoint format. Defaults to true for new configurations.",
        "default": true
      }
    ]
  },
  "parity_assessment": {
    "overall_status": "high",
    "event_parity": {
      "track": {
        "status": "full",
        "notes": "Custom event names and properties are forwarded identically. Both Segment and RudderStack produce equivalent PostHog capture events."
      },
      "identify": {
        "status": "full",
        "notes": "User identification with $set/$set_once trait splitting is supported. Both platforms merge anonymous and identified users via $anon_distinct_id."
      },
      "page": {
        "status": "full",
        "notes": "Page views mapped to $pageview with all standard PostHog page properties ($current_url, $pathname, $host, $referrer, $title)."
      },
      "screen": {
        "status": "full",
        "notes": "Mobile screen views mapped to $screen with $screen_name. Device and app context properties are forwarded."
      },
      "group": {
        "status": "full",
        "notes": "Group analytics mapped to $groupidentify with $group_type, $group_key, and $group_set. Nested trait objects are flattened."
      },
      "alias": {
        "status": "full",
        "notes": "Identity merging via $create_alias is supported. Links previousId to userId in PostHog's identity graph."
      }
    },
    "known_gaps": [
      {
        "gap_id": "PH-001",
        "description": "RudderStack adds envelope fields (rudderId, originalTimestamp, sentAt, receivedAt) not present in Segment payloads. These are stripped before delivery to PostHog and do not affect the destination payload, but timestamp computation may differ slightly.",
        "severity": "low",
        "impact": "No functional impact on PostHog event data. The computed timestamp in RudderStack uses (originalTimestamp + (receivedAt - sentAt)) which may differ from Segment's direct timestamp passthrough by milliseconds."
      },
      {
        "gap_id": "PH-002",
        "description": "Context library name differs between platforms: Segment sends 'analytics.js' / 'analytics-ios' while RudderStack sends 'rudder-sdk-js' / 'rudder-sdk-ios'. This maps to the $lib property in PostHog.",
        "severity": "low",
        "impact": "The $lib property value will differ in PostHog, which may affect filtering or segmentation by SDK source. Functionally equivalent."
      },
      {
        "gap_id": "PH-003",
        "description": "PostHog's group analytics feature requires group types to be pre-configured in the PostHog project settings. The default group type 'company' must exist. Custom group type mappings depend on destination configuration.",
        "severity": "medium",
        "impact": "If PostHog project does not have matching group types configured, $groupidentify events may fail silently or create unexpected group type entries."
      },
      {
        "gap_id": "PH-004",
        "description": "Nested object flattening strategy may differ between Segment and RudderStack. Segment may preserve nested objects while RudderStack flattens with underscore separators (e.g. address.city → address_city).",
        "severity": "low",
        "impact": "Property names in PostHog may differ between Segment-sourced and RudderStack-sourced events for nested trait/property objects. PostHog handles both formats."
      }
    ],
    "recommended_validation": [
      "Verify distinct_id is correctly resolved from userId with anonymousId fallback",
      "Validate $identify events include $anon_distinct_id for anonymous-to-identified user merging",
      "Confirm $set and $set_once trait splitting places createdAt in $set_once",
      "Check $pageview events include all 5 standard PostHog page properties ($current_url, $pathname, $host, $referrer, $title)",
      "Verify $screen events include $screen_name from the screen name field",
      "Validate $groupidentify events include $group_type, $group_key, and $group_set",
      "Confirm $create_alias events link previousId as the alias property",
      "Ensure api_key from destination config is injected into every outbound event",
      "Verify UTM campaign parameters are extracted from context.campaign to top-level utm_* properties",
      "Compare timestamp handling between Segment direct passthrough and RudderStack computed timestamp"
    ]
  },
  "notes": "PostHog shared cloud destination. Category: Analytics. PostHog is an open-source product analytics platform that provides event tracking, session replay, feature flags, experiments, and surveys. RudderStack sends events to PostHog via the Capture API (POST /i/v0/e/) with the project API key. All six standard event types (track, identify, page, screen, group, alias) are supported with full field mapping parity. Key integration points include distinct_id resolution from userId/anonymousId, $set/$set_once trait splitting for identify calls, $pageview/$screen event mapping for page/screen calls, $groupidentify for group analytics, and $create_alias for identity merging. PostHog supports both US Cloud (us.i.posthog.com) and EU Cloud (eu.i.posthog.com) regions as well as self-hosted instances."
}
