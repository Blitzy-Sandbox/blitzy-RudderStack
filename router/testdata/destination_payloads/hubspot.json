  "field_mappings": {
    "identify_to_contact": {
      "description": "Maps Segment/RudderStack identify traits to HubSpot Contact properties via Contacts API v3",
      "endpoint": "POST /crm/v3/objects/contacts (create) or PATCH /crm/v3/objects/contacts/{contactId} (update)",
      "trait_to_property_mapping": {
        "traits.email": "properties.email",
        "traits.firstName": "properties.firstname",
        "traits.lastName": "properties.lastname",
        "traits.phone": "properties.phone",
        "traits.company.name": "properties.company",
        "traits.title": "properties.jobtitle",
        "traits.address.street": "properties.address",
        "traits.address.city": "properties.city",
        "traits.address.state": "properties.state",
        "traits.address.postalCode": "properties.zip",
        "traits.address.country": "properties.country",
        "traits.website": "properties.website"
      },
      "dedup_strategy": "Email address is the primary dedup key in HubSpot. The Contacts API automatically de-duplicates on email. For upsert operations use batch/upsert with idProperty=email.",
      "lifecycle_stage_mapping": {
        "description": "HubSpot lifecycle stages track the contact's position in the marketing/sales funnel",
        "segment_trait": "traits.lifecycleStage or traits.lifecycle_stage",
        "hubspot_property": "properties.lifecyclestage",
        "valid_values": [
          "subscriber",
          "lead",
          "marketingqualifiedlead",
          "salesqualifiedlead",
          "opportunity",
          "customer",
          "evangelist",
          "other"
        ],
        "note": "Lifecycle stage values are case-sensitive lowercase in HubSpot API v3. Custom lifecycle stages can be retrieved via GET /crm/v3/properties/0-1/lifecyclestage."
      }
    },
    "track_to_event": {
      "description": "Maps Segment/RudderStack track events to HubSpot Custom Behavioral Events via Events API v3",
      "endpoint": "POST /events/v3/send",
      "event_name_mapping": {
        "strategy": "Segment event name is mapped to a pre-defined HubSpot custom event internal name (e.g., pe{portalId}_{snake_case_event_name})",
        "segment_field": "event",
        "hubspot_field": "eventName",
        "transformation": "Event name must match a pre-defined custom event in HubSpot. Typically converted to snake_case with portal-specific prefix.",
        "example": {
          "segment_event": "Product Viewed",
          "hubspot_eventName": "pe12345_product_viewed"
        }
      },
      "property_mapping": {
        "properties.*": "properties.* (passed through as custom event properties)",
        "userId": "Used to resolve contact via objectId lookup",
        "timestamp": "occurredAt (ISO 8601 format)",
        "context.page.title": "properties.hs_page_title",
        "context.page.url": "properties.hs_page_url"
      },
      "contact_resolution": "Contact is identified by objectId (HubSpot contact record ID), email, or utk cookie. If using userId, a lookup to resolve the HubSpot contact ID is required."
    },
    "track_to_deal": {
      "description": "Maps Segment/RudderStack track revenue events to HubSpot Deals via CRM Deals API v3",
      "endpoint": "POST /crm/v3/objects/deals",
      "applicable_events": [
        "Order Completed",
        "Checkout Completed",
        "Payment Received"
      ],
      "property_mapping": {
        "event": "properties.dealname (prefixed with event name)",
        "properties.total or properties.revenue": "properties.amount",
        "properties.currency": "properties.hs_currency",
        "timestamp": "properties.closedate",
        "properties.order_id": "properties.hs_deal_id (custom property)"
      },
      "deal_stage_mapping": {
        "default_stage": "closedwon",
        "pipeline": "default",
        "note": "Deal stage and pipeline must be pre-configured in HubSpot. Deal is associated with the contact via CRM Associations API (associationTypeId=3 for deal-to-contact)."
      }
    },
    "page_to_event": {
      "description": "Maps Segment/RudderStack page calls to HubSpot page view tracking via Events API v3",
      "endpoint": "POST /events/v3/send",
      "property_mapping": {
        "name": "Used in eventName context (e_visited_page)",
        "properties.title": "properties.hs_page_title",
        "properties.url": "properties.hs_page_url",
        "properties.referrer": "properties.hs_page_referrer",
        "properties.path": "properties.hs_page_url (combined with base URL)",
        "userId": "Used to resolve contact via email lookup",
        "timestamp": "occurredAt"
      },
      "note": "HubSpot natively tracks page views via its tracking code (hubspot.js). Server-side page events require sending via the custom events API with the e_visited_page event type or a custom-defined page tracking event."
    }
  },
  "parity_gaps": {
    "event_name_mapping": {
      "severity": "medium",
      "description": "HubSpot requires pre-defined custom events with portal-specific internal names (pe{portalId}_{name}). Both Segment and RudderStack must map free-form event names to registered HubSpot event definitions. The mapping strategy must be consistent."
    },
    "contact_resolution_for_events": {
      "severity": "medium",
      "description": "HubSpot events API requires identifying contacts by objectId, email, or utk. Neither Segment nor RudderStack userId maps directly — a contact lookup step is needed to resolve userId to HubSpot contact ID or email."
    },
    "lifecycle_stage_direction": {
      "severity": "low",
      "description": "HubSpot enforces unidirectional lifecycle stage progression by default (cannot move backwards without clearing first). Both platforms must handle this constraint identically."
    },
    "deal_creation_trigger": {
      "severity": "low",
      "description": "Deal creation from track events is a connector-specific behavior. Both platforms should use the same revenue event names to trigger deal creation, with consistent deal property mapping."
    },
    "context_library_fields": {
      "severity": "informational",
      "description": "Segment source events have context.library.name='analytics.js'; RudderStack source events have context.library.name='rudder-sdk-js'. These are SDK-level differences and do not affect the HubSpot destination payload."
    },
    "rudderstack_envelope_fields": {
      "severity": "informational",
      "description": "RudderStack adds rudderId, originalTimestamp, sentAt, receivedAt to source events. These fields are stripped before sending to HubSpot API and do not affect destination payload parity."
    },
    "segment_variants": {
      "severity": "informational",
      "description": "Segment offers 3 HubSpot variants: Classic (server-side), Cloud Mode (Actions), and Web (Actions). The Actions variants use configurable field mappings with event subscriptions. RudderStack uses a single cloud connector with fixed mapping logic via the Transformer service."
    }
  },
  "authentication": {
    "method": "OAuth 2.0 Bearer Token",
    "token_endpoint": "https://api.hubapi.com/oauth/v1/token",
    "scopes_required": [
      "crm.objects.contacts.read",
      "crm.objects.contacts.write",
      "crm.objects.deals.read",
      "crm.objects.deals.write",
      "analytics.behavioral_events.send"
    ],
    "rate_limits": {
      "oauth_apps": "100 requests per 10 seconds per account",
      "private_apps": "200 requests per 10 seconds per account",
      "burst": "Burst requests may trigger 429 Too Many Requests"
    },
    "note": "Both Segment and RudderStack use OAuth 2.0 for HubSpot API access. API key authentication is deprecated as of November 2022."
  },
